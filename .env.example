# Copy to .env (setup does it) and fill what you use. Everything is optional except for the
# features that need it.

# Higgsfield: generated images (photos, illustrations, vector-style logos). https://console.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# generations estimated above this many USD need explicit confirmation (--yes)
DA_HF_MAX_USD=2

# Pexels: free stock photos. https://www.pexels.com/api/
PEXELS_API_KEY=

# Unsplash: free stock photos (Access Key). https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# CMYK conversion profile for print PDFs (an .icc file). Empty = auto-detect (Adobe's Coated
# FOGRA39 when Creative Cloud is installed, else a generic profile, else a plain formula).
DA_CMYK_ICC=
